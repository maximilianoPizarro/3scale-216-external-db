# Copy to ~/values-secret-3scale-216-external-db.yaml and keep that file out of git.
# scripts/load-vault-kv.sh writes these fields into Vault KV v2.
# Paths: secret/hub/3scale-postgresql, secret/hub/3scale-system-redis,
# secret/hub/3scale-backend-redis.
version: "2.0"

secrets:
  - name: 3scale-postgresql
    fields:
      - name: username
        value: system
      - name: password
        value: REPLACE_WITH_PASSWORD

  - name: 3scale-system-redis
    fields:
      - name: password
        value: REPLACE_WITH_PASSWORD

  - name: 3scale-backend-redis
    fields:
      - name: password
        value: REPLACE_WITH_PASSWORD
