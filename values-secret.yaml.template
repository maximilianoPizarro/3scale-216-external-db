# Copy to ~/values-secret-3scale-216-external-db.yaml and keep that file out of git.
# `./pattern.sh make install` loads these fields into Vault KV v2.
# Paths: secret/data/hub/3scale-postgresql, secret/data/hub/3scale-system-redis,
# secret/data/hub/3scale-backend-redis.
version: "2.0"

secrets:
  - name: 3scale-postgresql
    fields:
      - name: username
        value: system
      - name: password
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy

  - name: 3scale-system-redis
    fields:
      - name: password
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy

  - name: 3scale-backend-redis
    fields:
      - name: password
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy
